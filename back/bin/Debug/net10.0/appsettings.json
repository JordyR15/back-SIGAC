{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Smtp": {
    "Host": "",            // e.g. smtp.mailtrap.io or smtp.gmail.com
    "Port": "587",
    "User": "",
    "Pass": "",
    "From": "no-reply@example.com",
    "EnableSsl": "true"
  },

  "BulkUpload": {
    "MaxRows": "500",
    "AllowedEmailDomains": ""  // comma-separated; empty = allow any domain
  }
}
